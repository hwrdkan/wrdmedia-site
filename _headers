/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

/styles.css
  Cache-Control: no-cache

/script.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/pergola/
  Cache-Control: no-cache

/pergola/index.html
  Cache-Control: no-cache

/pergola/src/style.css
  Cache-Control: no-cache

/resume/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-cache
